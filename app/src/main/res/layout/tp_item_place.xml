<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="8dp"
    android:background="#F9F9F9"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp">

    <!-- Header with checkbox and name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <CheckBox
            android:id="@+id/checkbox_place"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:buttonTint="#FF6B6B" />

        <TextView
            android:id="@+id/text_place_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Place Name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1a1a1a"
            android:maxLines="2"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Tags -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Catégories: "
            android:textSize="13sp"
            android:textColor="#757575"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/text_tags"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Restauration, Loisirs"
            android:textSize="13sp"
            android:textColor="#4ECDC4"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Price -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prix: "
            android:textSize="13sp"
            android:textColor="#757575"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/text_price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="25.50 €"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FF6B6B" />

    </LinearLayout>

    <!-- Time Spent -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Durée: "
            android:textSize="13sp"
            android:textColor="#757575"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/text_time_spent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2 h"
            android:textSize="13sp"
            android:textColor="#45B7D1" />

    </LinearLayout>

    <!-- Location -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Localisation: "
            android:textSize="13sp"
            android:textColor="#757575"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/text_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="43.6108, 3.8767"
            android:textSize="12sp"
            android:textColor="#96CEB4"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

</LinearLayout>
